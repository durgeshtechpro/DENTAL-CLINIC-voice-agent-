LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
API_KEY=
WEBHOOK_SECRET=
# Clinic address the voice agent calls. Leave empty to use http://127.0.0.1:8001.
CLINIC_BASE_URL=http://127.0.0.1:8001
# Call API address the voice agent posts results to. Leave empty to use http://127.0.0.1:8000.
API_BASE_URL=http://127.0.0.1:8000
# Browser origins allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:3000
# Folder for the API and clinic SQLite files. Leave empty to keep each file in its own folder.
DATA_DIR=
# Port used by python -m api.main. Leave empty to use 8000. The uvicorn command keeps its own port.
PORT=

